# ============================================================================
# SplitSmart AI - Enterprise Environment Configuration
# ============================================================================

PORT=5000
APP_URL=http://localhost:5000
JWT_SECRET=splitsmart_jwt_production_secret_key_fintech_secure_ledger_2026

# PostgreSQL Database Connection URL
# Local: postgres://postgres:password@localhost:5432/splitsmart
# Cloud (Neon/Render): postgres://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# Nodemailer SMTP Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SplitSmart AI" <your-email@gmail.com>

# PayPal Sandbox API Credentials
# Reference: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# LLM API Key (Google AI Studio Gemini / OpenAI)
# Gemini: https://aistudio.google.com/app/apikey
# OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=
LLM_PROVIDER=gemini
